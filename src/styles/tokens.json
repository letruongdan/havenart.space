{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Haven Art Design Tokens",
  "version": "1.0.0",
  "description": "Calm, serene, non-intrusive aesthetic tokens for Haven Art with WCAG AA accessibility",
  "color": {
    "background": "#fbf9f5",
    "surface": "#f2efe9",
    "textPrimary": "#1c1917",
    "textMuted": "#57534e",
    "border": "#e7e5e4",
    "accent": "#92400e",
    "dark": {
      "background": "#121316",
      "surface": "#1a1d24",
      "textPrimary": "#f5f5f4",
      "textMuted": "#a8a29e",
      "border": "#292524",
      "accent": "#fbbf24"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "haven": "16px",
    "lg": "24px",
    "full": "9999px"
  },
  "motion": {
    "durationFast": "150ms",
    "durationNormal": "350ms",
    "durationSlow": "600ms",
    "reducedMotionFallback": "0s",
    "easing": "cubic-bezier(0.25, 1, 0.5, 1)"
  },
  "typography": {
    "fontSans": "'Be Vietnam Pro', 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif",
    "fontSerif": "'Cormorant Garamond', 'Playfair Display', ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif",
    "lineHeightRelaxed": "1.75"
  }
}
