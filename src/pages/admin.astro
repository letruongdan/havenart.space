---
import '../styles/tokens.css';
import AdminDashboard from '../components/admin/AdminDashboard.svelte';
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/Lora-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/BeVietnamPro-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#090a0d" />
    <title>Haven Art — Bảng Quản Trị & Giám Sát Hệ Thống</title>
    <meta
      name="description"
      content="Bảng điều khiển theo dõi hệ thống, kiểm tra hiệu năng, lưu trữ IndexedDB, âm thanh và đồ họa của Haven Art."
    />
  </head>
  <body class="bg-[#090a0d] text-[#f5f5f4] min-h-screen antialiased selection:bg-amber-400/30">
    <AdminDashboard client:load />
  </body>
</html>
