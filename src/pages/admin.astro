---
import '../styles/tokens.css';
import AdminDashboard from '../components/admin/AdminDashboard.svelte';
import SEO from '../components/SEO.astro';
export const prerender = true;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="Haven Art — Bảng Quản Trị Hệ Thống"
      description="Khu vực quản trị nội bộ hệ thống Haven Art."
      noindex={true}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/Lora-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/BeVietnamPro-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body class="bg-[#090a0d] text-[#f5f5f4] min-h-screen antialiased selection:bg-amber-400/30">
    <AdminDashboard client:load />
  </body>
</html>
