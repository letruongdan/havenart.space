---
import '../styles/tokens.css';
import HavenShell from '../components/HavenShell.svelte';
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#121316" />
    <title>Haven Art — Góc tĩnh lặng cho tâm hồn</title>
    <meta
      name="description"
      content="Haven Art — Không gian tĩnh lặng, âm nhạc thiền định và nhật ký an yên cho tâm hồn."
    />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
          // In local dev, unregister stale service workers to prevent Vite HMR & port collisions
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const registration of registrations) {
              registration.unregister();
            }
          });
        } else if (window.location.protocol.startsWith('http')) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      }
    </script>
  </head>
  <body class="bg-[#fbf9f5] dark:bg-[#121316] text-[#1c1917] dark:text-[#f5f5f4] min-h-screen antialiased selection:bg-amber-200 dark:selection:bg-amber-900/60">
    <HavenShell client:load />
  </body>
</html>
