---
import '../styles/tokens.css';
import HavenShell from '../components/HavenShell.svelte';
import SEO from '../components/SEO.astro';
import { SUPPORTED_LANGUAGES, type SupportedLanguage } from '../lib/i18n/types';
export const prerender = false;
const requested = Astro.url.searchParams.get('lang');
const urlLang = SUPPORTED_LANGUAGES.some(l => l.code === requested) ? requested as SupportedLanguage : undefined;
---
<!doctype html>
<html lang={urlLang || 'vi'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO language={urlLang || 'vi'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/Lora-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/BeVietnamPro-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline define:vars={{ isDev: import.meta.env.DEV }}>
      if ('serviceWorker' in navigator) {
        if (isDev) {
          // In local dev, unregister stale service workers to prevent Vite HMR & port collisions
          navigator.serviceWorker.getRegistration('/').then((registration) => {
            if (registration?.active?.scriptURL.endsWith('/sw.js')) registration.unregister();
          });
        } else if (window.location.protocol.startsWith('http')) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      }
    </script>
  </head>
  <body class="bg-[#fbf9f5] dark:bg-[#121316] text-[#1c1917] dark:text-[#f5f5f4] min-h-screen antialiased selection:bg-amber-200 dark:selection:bg-amber-900/60">
    <HavenShell initialLang={urlLang} client:load />
  </body>
</html>
